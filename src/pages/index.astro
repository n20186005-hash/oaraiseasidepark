  <div class="copy-toast" data-copy-toast role="status" aria-live="polite">住所をコピーしました</div>

  <script>
    const copyButton = document.querySelector('[data-copy-address]');
    const toast = document.querySelector('[data-copy-toast]');
    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('〒311-1305 茨城県東茨城郡大洗町港中央');
        toast?.classList.add('show');
        window.setTimeout(() => toast?.classList.remove('show'), 1800);
      } catch {
        window.prompt('住所をコピーしてください', '〒311-1305 茨城県東茨城郡大洗町港中央');
      }
    });

    document.querySelectorAll('[data-route-tab]').forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-route-tab');
        document.querySelectorAll('[data-route-tab]').forEach((item) => item.setAttribute('aria-selected', String(item === button)));
        document.querySelectorAll('[data-route-panel]').forEach((panel) => {
          panel.toggleAttribute('hidden', panel.getAttribute('data-route-panel') !== target);
        });
      });
    });

    document.querySelectorAll('[data-current-year]').forEach((element) => {
      element.textContent = String(new Date().getFullYear());
    });

    document.querySelectorAll('.mobile-menu a').forEach((link) => {
      link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
    });
  </script>

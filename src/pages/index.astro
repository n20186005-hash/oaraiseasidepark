---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MemorialCard from '@/components/MemorialCard.astro';
import WeatherWidget from '@/components/WeatherWidget.astro';

const title = '大洗海浜公園｜駐車場・アクセス・園内施設・写真ガイド';
const description = '大洗海浜公園（茨城県大洗町）の観光ガイド。駐車場の料金・利用期間、アクセス、芝生広場や多目的広場、写真スポット、周辺の観光情報を紹介します。';

const siteUrl = Astro.site ? Astro.site.origin : 'https://oaraiseasidepark.com';
const domainName = 'oaraiseasidepark.com';
const attractionFullName = '大洗海浜公園';
const attractionShortName = 'Oarai Seaside Park';
const cityName = '大洗町';
const stateProvince = '茨城県';
const countryName = '日本';
const mapsShareUrl = 'https://maps.app.goo.gl/fLMtVbzM3GDguMRP8';
const mapsEmbedSrc = 'https://www.google.com/maps?q=Oarai%20Seaside%20Park&ll=36.3044132,140.5664618&z=15&output=embed';
const govtTourismUrl = 'https://www.ibarakiguide.jp/';
const townOfficialUrl = 'https://www.town.oarai.ibaraki.jp/';
const mapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(attractionFullName)}`;
const nearbyLandmark1 = '大洗マリンタワー';
const nearbyLandmark2 = '大洗磯前神社（神磯の鳥居）';

const reviews = {
  rating: 4.1,
  count: 1058,
  source: 'Google Maps',
  syncedAt: '2026 年 10 月',
};

const faqs = [
  { q: '入園料や開園時間は？', a: '散歩、休憩、外遊びなど通常利用は無料で、常時利用できます。海水浴場の監視、シャワー、更衣室など季節設備には開設期間・利用時間があります。' },
  { q: '公園で泳げますか？', a: '遊泳は隣接する大洗サンビーチの海水浴場開設期間・指定区域で楽しんでください。開設期間外は監視員がいないため、海況に十分注意してください。' },
  { q: '子ども連れでも過ごしやすいですか？', a: '芝生広場、遊歩道、休憩スペース、トイレがあり、親子で過ごしやすい公園です。海辺では子どもから目を離さず、夏は地面の熱さと熱中症に注意してください。' },
  { q: '写真は本当にアップロードされませんか？', a: 'このページの記念カード機能は、ブラウザの Canvas を使って端末内だけで合成します。選択した写真、入力文字、完成画像をサーバーへ送信する処理はありません。' },
  { q: '大洗海浜公園はどこにありますか？', a: `大洗海浜公園（${attractionShortName}）は${stateProvince}${cityName}港中央にあります。大洗駅から徒歩で約18〜20分、車では水戸大洗ICから通常約10分です。` },
  { q: '大洗海浜公園へのアクセス方法は？', a: 'JR常磐線で水戸駅へ、そこから鹿島臨海鉄道大洗鹿島線で大洗駅まで。大洗駅からは徒歩約18〜20分、または町内循環バス「海遊号」が利用できます。' },
  { q: '駐車場はありますか？', a: '公園やサンビーチ周辺に町営・公営の駐車場が複数あります。繁忙期やイベント日は有料・満車になりやすいため、公共交通の利用も検討されます。最新の運用は来訪前にご確認ください。' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${siteUrl}/#attraction`,
  name: attractionFullName,
  alternateName: [attractionShortName, `${attractionShortName} ${cityName}`],
  description,
  url: `${siteUrl}/`,
  image: [`${siteUrl}/images/hero-oarai.webp`],
  isAccessibleForFree: true,
  publicAccess: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: reviews.rating,
    reviewCount: reviews.count,
  },
  address: {
    '@type': 'PostalAddress',
    postalCode: '311-1305',
    addressRegion: stateProvince,
    addressLocality: cityName,
    streetAddress: '港中央',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 36.3044132,
    longitude: 140.5664618,
  },
  hasMap: mapsShareUrl,
  sameAs: [mapsShareUrl, govtTourismUrl],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={title} description={description}>
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <header class="site-header" data-header>
    <div class="header-inner">
      <a class="brand" href="#top" aria-label="大洗海浜公園ガイド トップへ">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M5 28c6-7 12-7 18 0s12 7 20 0"/><circle cx="33" cy="16" r="5"/></svg>
        </span>
        <span><strong>大洗海浜公園</strong><small>OARAI KAIHIN PARK</small></span>
      </a>
      <nav class="desktop-nav" aria-label="ページ内ナビゲーション">
        <a href="#weather">天気</a>
        <a href="#enjoy">楽しみ方</a>
        <a href="#food">周辺グルメ</a>
        <a href="#access">アクセス</a>
        <a href="#services">施設</a>
        <a href="#nearby">周辺スポット</a>
        <a href="/parking/">駐車場</a>
        <a class="nav-cta" href="#memory-card">記念カード</a>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <nav aria-label="モバイルナビゲーション">
          <a href="#weather">天気</a>
          <a href="#enjoy">楽しみ方</a>
          <a href="#food">周辺グルメ</a>
          <a href="#access">アクセス</a>
          <a href="#services">施設</a>
          <a href="#nearby">周辺スポット</a>
          <a href="/parking/">駐車場</a>
          <a href="#memory-card">記念カード</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      <img class="hero-image" src="/images/hero-oarai.webp" alt="大洗の海辺から望む太平洋の日の出" width="1920" height="1080" fetchPriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-grain"></div>
      <div class="hero-content">
        <p class="hero-eyebrow">IBARAKI · OARAI · PACIFIC COAST</p>
        <h1 id="hero-title">大洗海浜公園｜<br /><em>太平洋を望む海辺の公園。</em></h1>
        <p class="hero-sub">海と港のあいだで、深呼吸する休日。</p>
        <p class="hero-copy">広い芝生、潮風の遊歩道、その先に続く大洗サンビーチ。朝の散歩から夕暮れまで、予定を詰め込まずに過ごせる海辺の公園です。</p>
        <div class="hero-actions">
          <a class="primary-button" href="#access">行き方を見る</a>
          <a class="ghost-button" href="#memory-card">記念カードを作る</a>
        </div>
      </div>
      <div class="hero-facts" aria-label="基本情報">
        <div><span>OPEN</span><strong>常時利用可</strong></div>
        <div><span>ADMISSION</span><strong>入園無料</strong></div>
        <div><span>FROM STATION</span><strong>徒歩 約20分</strong></div>
        <div><span>LOCATION</span><strong>大洗町 港中央</strong></div>
      </div>
      <a class="scroll-cue" href="#overview" aria-label="概要へスクロール"><span>SCROLL</span><i></i></a>
    </section>

    <section id="overview" class="intro section-shell">
      <div class="intro-title-block">
        <span class="vertical-label">OARAI SEASIDE</span>
        <div>
          <div class="section-kicker">ABOUT THE PARK</div>
          <h2 class="section-title">海辺の日常を、<br />ゆっくり味わう場所。</h2>
        </div>
      </div>
      <div class="intro-copy">
        <p>大洗海浜公園は、大洗港のマリーナ地区に整備された開放的な海辺の公園です。芝生広場、遊歩道、多目的広場、休憩スペースがまとまり、隣接する大洗サンビーチと一続きのように楽しめます。</p>
        <p>海水浴だけを目的にせず、散歩、ピクニック、港の眺め、親子の外遊びなど、季節に合わせて自由に過ごせるのが魅力。マリンタワーやシーサイドステーションにも近く、大洗観光の起点にも向いています。</p>
        <p class="entity-equivalence">大洗海浜公園は、英語圏では <strong>Oarai Seaside Park</strong> として知られる、${stateProvince}${cityName}の太平洋沿いにある海辺の公園です。周辺には${nearbyLandmark1}や${nearbyLandmark2}など、大洗を代表するスポットが点在しています。</p>
        <div class="review-note"><span>情報確認日</span><strong>2026.10.13</strong><small>季節設備・駐車料金・催事は来訪前に最新案内をご確認ください。</small></div>
        <nav class="entity-breadcrumb" aria-label="所在地の階層">
          <span>大洗海浜公園</span><i aria-hidden="true">→</i><span>大洗町</span><i aria-hidden="true">→</i><span>茨城県</span><i aria-hidden="true">→</i><span>日本</span>
        </nav>
      </div>
    </section>

    <section id="reviews" class="section-shell reviews-section" aria-labelledby="reviews-title">
      <div class="section-heading-row">
        <div>
          <div class="section-kicker">GOOGLE MAPS REVIEWS</div>
          <h2 id="reviews-title" class="section-title">評価とクチコミ</h2>
        </div>
        <p class="section-lead">訪れた方々の声を、Google マップのユーザー評価からまとめました。評価は公式のものではなく、あくまで参考情報です。</p>
      </div>

      <div class="review-card">
        <div class="review-score">
          <div class="review-rating" aria-label={`Google マップ評価 ${reviews.rating}（5段階）、${reviews.count}件`}>
            <span class="review-number">{reviews.rating}</span>
            <span class="review-stars" style={`--rating:${reviews.rating};`} aria-hidden="true"></span>
          </div>
          <p class="review-count"><strong>{reviews.count.toLocaleString()}</strong> 件の Google マップ評価</p>
          <p class="review-source-line">评分与评价数同步自谷歌地图（Google Maps）用户评价 · {reviews.syncedAt} · <a href={mapsShareUrl} target="_blank" rel="noopener noreferrer">点击查看谷歌地图全部评价↗</a></p>
        </div>
        <div class="review-cta">
          <p class="review-note-text">同步自 Google 地图用户评价，同步时间 {reviews.syncedAt}；版权归原作者与 Google 地图所有</p>
          <a class="primary-button" href={mapsShareUrl} target="_blank" rel="noopener noreferrer">在谷歌地图查看全部评价</a>
        </div>
      </div>
    </section>

    <WeatherWidget />

    <section class="photo-band" aria-label="大洗港の風景">
      <img src="/images/oarai-port-wide.webp" alt="大洗港と太平洋を見渡す風景" width="1600" height="900" loading="lazy" />
      <div class="photo-band-caption"><span>PORT &amp; HORIZON</span><strong>港の動きと、水平線の静けさ。</strong></div>
    </section>

    <section id="enjoy" class="section-shell enjoy-section" aria-labelledby="enjoy-title">
      <div class="section-heading-row">
        <div>
          <div class="section-kicker">HOW TO SPEND</div>
          <h2 id="enjoy-title" class="section-title">公園での過ごし方</h2>
        </div>
        <p class="section-lead">派手なアトラクションではなく、海辺の余白を楽しむ場所。時間帯と季節で表情が変わります。</p>
      </div>
      <div class="experience-grid">
        <article class="experience-card large-card">
          <div class="card-number">01</div>
          <div class="experience-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="18" r="8"/><path d="M7 35c7-7 12-7 18 0s11 7 16 1"/></svg></div>
          <h3>朝の海辺を歩く</h3>
          <p>東向きの海岸では、空がゆっくり明るくなる時間が格別。風の弱い日は水面の光を眺めながら、遊歩道を無理なく歩けます。</p>
          <span class="time-tag">おすすめ：日の出前後</span>
        </article>
        <article class="experience-card image-card">
          <img src="/images/sun-beach-card.webp" alt="大洗の海岸と朝日" width="1200" height="900" loading="lazy" />
          <div class="image-card-overlay"><span>02</span><h3>サンビーチへ足を延ばす</h3><p>広い砂浜と遠浅の海。遊泳は指定期間・区域を守り、風と波の状況を確認して楽しみましょう。</p></div>
        </article>
        <article class="experience-card">
          <div class="card-number">03</div>
          <div class="experience-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 34h32M13 28h22M17 22h14M22 10h4v12"/><path d="M10 38c7-5 13-5 20 0"/></svg></div>
          <h3>芝生でひと休み</h3>
          <p>レジャーシートと飲み物があれば十分。強い日差しと海風に備え、帽子や羽織りものも用意すると快適です。</p>
          <span class="time-tag">おすすめ：春・秋</span>
        </article>
        <article class="experience-card">
          <div class="card-number">04</div>
          <div class="experience-icon"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="8" y="13" width="32" height="24" rx="3"/><circle cx="24" cy="25" r="7"/><path d="M16 13l3-4h10l3 4"/></svg></div>
          <h3>海辺の写真を残す</h3>
          <p>朝は青と金、夕方は砂色と橙色。水平線をまっすぐ入れるだけでも、大洗らしい一枚になります。</p>
          <a href="#memory-card" class="inline-link">写真を記念カードにする <span>→</span></a>
        </article>
      </div>
    </section>

    <section class="season-section">
      <div class="section-shell">
        <div class="section-heading-row light-heading">
          <div><div class="section-kicker">SEASONS</div><h2 class="section-title">四季の海辺メモ</h2></div>
          <p class="section-lead">同じ公園でも、装備と楽しみ方は季節ごとに少しずつ変わります。</p>
        </div>
        <div class="season-grid">
          <article><span>春</span><h3>潮の時間を調べて</h3><p>サンビーチで潮干狩りを楽しむ場合は、採取区域・道具・貝の大きさなど現地ルールを事前に確認。</p></article>
          <article><span>夏</span><h3>遊泳区域を守る</h3><p>2026年の海水浴場開設は7月18日〜8月16日。日陰、水分、サンダルの熱さにも注意。</p></article>
          <article><span>秋</span><h3>空の広さを楽しむ</h3><p>散歩とピクニックに向く季節。イベント開催日は駐車場や周辺道路が混み合うことがあります。</p></article>
          <article><span>冬</span><h3>防風をしっかり</h3><p>日の出と澄んだ水平線が魅力。海風は体感温度を下げるため、手袋や防風アウターがあると安心。</p></article>
        </div>
      </div>
    </section>

    <section id="season-table" class="section-shell season-strategy-section" aria-labelledby="season-strategy-title">
      <div class="section-heading-row">
        <div><div class="section-kicker">SEASONAL STRATEGY</div><h2 id="season-strategy-title" class="section-title">季節ごとの過ごし方</h2></div>
        <p class="section-lead">気象庁の平年値（長期統計）と大洗の海辺の特徴をもとにした、一般的な傾向です。年によって異なります。</p>
      </div>
      <div class="season-table-wrap">
        <table class="season-table">
          <thead>
            <tr><th scope="col">季節</th><th scope="col">気象と過ごし方</th><th scope="col">海水・水質</th><th scope="col">自然と生物</th><th scope="col">おすすめ装備</th></tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">春<br /><small>3–5月</small></th>
              <td>寒暖の差が大きく、風の弱い日は散歩や潮干狩りに。大型連休は混雑します。</td>
              <td>水温はまだ低く、遊泳前の時期。磯の観察には適しています。</td>
              <td>潮だまりに生物が活発で、神磯の鳥居の穏やかな海が見られます。</td>
              <td>ウインドブレーカー、履きなれた靴、飲料。</td>
            </tr>
            <tr>
              <th scope="row">夏<br /><small>6–8月</small></th>
              <td>暑く、紫外線と熱中症対策が必須。海水浴（開設期間）や花火・イベントが多数。</td>
              <td>海水浴場開設で水質調査と監視があります。台風期は海況に注意。</td>
              <td>海の生物観察や、夕方の入道雲が特徴的です。</td>
              <td>日焼け止め、帽子、水分、サンダル。</td>
            </tr>
            <tr>
              <th scope="row">秋<br /><small>9–11月</small></th>
              <td>爽やかで散歩・ピクニック・サーフィンに最適な季節。</td>
              <td>水温は下がり始めます。監視のない日は海況をよく確認を。</td>
              <td>空気が澄み写真映え、渡り鳥の季節でもあります。</td>
              <td>軽い防寒、リュック、動きやすい服装。</td>
            </tr>
            <tr>
              <th scope="row">冬<br /><small>12–2月</small></th>
              <td>寒く北風が強い。初日の出と澄んだ水平線の撮影に向きます。</td>
              <td>荒波の日が多く、遊泳は厳禁です。</td>
              <td>寒鱈（フグ・ヒラメ等）の季節。荒波の生き物観察も。</td>
              <td>防風アウター、手袋、帽子。</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section id="plans" class="section-shell plans-section" aria-labelledby="plans-title">
      <div class="section-heading-row">
        <div><div class="section-kicker">RECOMMENDED PLANS</div><h2 id="plans-title" class="section-title">目的別の過ごし方とルート</h2></div>
        <p class="section-lead">訪れる方の構成やペースに合わせて、三つの視点と半日・一日のルートをご提案します。</p>
      </div>

      <div class="plan-group">
        <article class="plan-card">
          <span class="plan-tag">グループ別</span>
          <h3>親子家族</h3>
          <p>マリンタワー（展望・トイレに近い）→ 芝生広場でのびのび → サンビーチの砂遊び → 科学館で雨の日も安心。こまめな休憩とトイレを意識すると一日が穏やかです。</p>
        </article>
        <article class="plan-card">
          <span class="plan-tag">グループ別</span>
          <h3>写真・自然派</h3>
          <p>神磯の鳥居の日の出 → マリンタワーからの水平線 → 防波堤の波 → 夕暮れの砂色。朝の人の少ない時間帯が狙い目です。</p>
        </article>
        <article class="plan-card">
          <span class="plan-tag">グループ別</span>
          <h3>ゆったり・バリアフリー</h3>
          <p>平らな遊歩道とベンチ → バリアフリートイレ → 駐車場近くの区画 → 海遊号バスを活用。無理なく往復できるよう段取りを。</p>
        </article>
      </div>

      <div class="plan-routes">
        <article class="route-card half-day">
          <div class="route-card-head"><span class="route-badge">半日</span><h3>気軽コース（約3–4時間）</h3></div>
          <ol class="route-timeline">
            <li><span>大洗駅</span><p>徒歩で公園方面へ。</p></li>
            <li><span>公園散歩</span><p>芝生広場と遊歩道をのんびり。</p></li>
            <li><span>マリンタワー</span><p>展望から港と太平洋を一望。</p></li>
            <li><span>サンビーチの海辺</span><p>砂浜で潮風を感じる。</p></li>
            <li><span>港エリアで軽食</span><p>港周辺で一休みして駅へ。</p></li>
          </ol>
        </article>
        <article class="route-card full-day">

---
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pageName: string;
  kicker?: string;
  heroTitle: string;
  heroSubtitle?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  pageName,
  kicker = 'OARAI SEASIDE PARK GUIDE',
  heroTitle,
  heroSubtitle,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://oaraiseasidepark.com';
const path = Astro.url.pathname;
const pageUrl = Astro.site ? new URL(path, Astro.site).toString() : path;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: pageName, item: pageUrl },
  ],
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  url: pageUrl,
  description,
  isPartOf: { '@type': 'WebSite', name: '大洗海浜公園ガイド', url: `${siteUrl}/` },
  about: { '@type': 'TouristAttraction', name: '大洗海浜公園', url: `${siteUrl}/#attraction` },
};

const extraLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const allLd = [breadcrumb, webPageLd, ...extraLd];

const related = [
  { href: '/parking/', name: '駐車場', desc: '料金・利用期間・入口' },
  { href: '/access/', name: 'アクセス', desc: '電車・車・バスでの行き方' },
  { href: '/facilities/', name: '園内施設', desc: '芝生広場・多目的広場' },
  { href: '/photos/', name: '写真', desc: '海辺の風景ギャラリー' },
];
---

<BaseLayout title={title} description={description}>
  {allLd.map((ld) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}

  <header class="sub-header">
    <div class="sub-header-inner">
      <a class="brand" href="/#top" aria-label="大洗海浜公園ガイド トップへ">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M5 28c6-7 12-7 18 0s12 7 20 0"/><circle cx="33" cy="16" r="5"/></svg>
        </span>
        <span><strong>大洗海浜公園</strong><small>OARAI KAIHIN PARK</small></span>
      </a>
      <nav class="sub-nav" aria-label="特集ナビゲーション">
        <a href="/parking/">駐車場</a>
        <a href="/access/">アクセス</a>
        <a href="/facilities/">園内施設</a>
        <a href="/photos/">写真</a>
        <a class="sub-nav-home" href="/">ホーム</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="topic-hero" aria-labelledby="topic-hero-title">
      <div class="topic-hero-inner">
        <p class="topic-hero-kicker">{kicker}</p>
        <h1 id="topic-hero-title" class="topic-hero-title">{heroTitle}</h1>
        {heroSubtitle && <p class="topic-hero-sub">{heroSubtitle}</p>}
      </div>
    </section>

    <nav class="breadcrumb-bar" aria-label="パンくずリスト">
      <ol class="breadcrumb section-shell">
        <li><a href="/">ホーム</a></li>
        <li aria-current="page">{pageName}</li>
      </ol>
    </nav>

    <slot />

    <section class="section-shell related-guides" aria-labelledby="related-title">
      <div class="section-kicker">RELATED GUIDES</div>
      <h2 id="related-title" class="section-title">ほかの特集ガイド</h2>
      <div class="related-grid">
        {related.filter((r) => r.href !== path).map((r) => (
          <a class="related-card" href={r.href}>
            <strong>{r.name}</strong>
            <span>{r.desc}</span>
            <span class="related-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="topic-footer">
    <div class="section-shell topic-footer-grid">
      <div class="footer-brand">
        <span class="brand-mark"><svg viewBox="0 0 48 48"><path d="M5 28c6-7 12-7 18 0s12 7 20 0"/><circle cx="33" cy="16" r="5"/></svg></span>
        <div><strong>大洗海浜公園</strong><small>海と港のあいだで、深呼吸する休日。</small></div>
      </div>
      <nav aria-label="フッターナビゲーション">
        <a href="/">ホーム</a>
        <a href="/parking/">駐車場</a>
        <a href="/access/">アクセス</a>
        <a href="/facilities/">園内施設</a>
        <a href="/photos/">写真</a>
      </nav>
    </div>
    <div class="footer-bottom section-shell">
      <p>本サイトは大洗町・茨城県および各施設の公式サイトではありません。</p>
      <p>© <span data-current-year></span> Oarai Kaihin Park Guide</p>
    </div>
  </footer>

  <script>
    document.querySelectorAll('[data-current-year]').forEach((element) => {
      element.textContent = String(new Date().getFullYear());
    });
  </script>
</BaseLayout>

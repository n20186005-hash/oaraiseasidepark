{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oaraikaihinpark",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
